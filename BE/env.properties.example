# Copy this file to env.properties (ignored by git) and fill in the values.
DB_URL=jdbc:postgresql://localhost:5432/U5W6D3
DB_USERNAME=postgres
DB_PASSWORD=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# The OpenRouter key should NOT be written here. Set it once as a user environment variable:
#   PowerShell: [Environment]::SetEnvironmentVariable('OPENROUTER_API_KEY', '<your key>', 'User')
# then restart the terminal / IDE. Without the key the app still starts and the chat shows an error.
